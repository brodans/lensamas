# Lensamas environment variables for Vercel and local development (.env):
API_BASE_URL=https://nawasara.ponorogo.go.id
API_TOKEN=replace-with-your-api-token
API_ORIGIN=https://gasta.ponorogo.go.id
APP_ORIGIN=http://localhost:5173

# Request log opsional. npm run dev/preview selalu menonaktifkan log API.
REQUEST_LOG=0
REQUEST_LOG_LEVEL=info
REQUEST_LOG_ALL=0
REQUEST_LOG_STACK=0
# Default ringkas: hanya request ID, route, status, durasi, dan outcome.
REQUEST_LOG_VERBOSE=0

# Sumber CCTV publik. Tidak ada username/password yang ditanam di kode;
# isi token hanya jika upstream deployment Anda memang memerlukannya.
# CCTV Kota Madiun: IP official menjadi primary; Villabs digunakan fallback
MADIUN_PRIMARY_API_URL=https://103.149.120.205/api/app/camera/
# Host TLS untuk sertifikat IP; jangan ubah ke HTTP untuk melewati verifikasi
MADIUN_PRIMARY_TLS_HOST=cctv.villabs.id
MADIUN_PRIMARY_USER_AGENT=Mozilla/5.0 (compatible; LENSAMAS CCTV proxy/1.0)
MADIUN_API_URL=https://cctv.villabs.id/api/app/camera/
MADIUN_ORIGIN=https://cctv.villabs.id
MADIUN_STREAM_BASE=wss://cctv.villabs.id/streamer-jsmpeg/streamer
MAGETAN_LIST_URL=https://cctv.saranganvision.com/
MAGETAN_ALLOWED_HOSTS=saranganvision.my.id,www.saranganvision.my.id,cctv.saranganvision.com
TRENGGALEK_GEOTIK_LIST_URL=https://geotik.trenggalekkab.go.id/home/get_cctv
TRENGGALEK_GEOTIK_ORIGIN=https://geotik.trenggalekkab.go.id
TRENGGALEK_STREAM_HOST=stream.trenggalekkab.go.id
TRENGGALEK_LIST_URL=https://tgxportal.trenggalekkab.go.id/cctv/show
TRENGGALEK_ORIGIN=https://tgxportal.trenggalekkab.go.id

# CCTV Kota Malang (portal resmi; HLS di-proxy same-origin)
MALANG_API_URL=https://cctv.malangkota.go.id/api/v2/get-cameras
MALANG_PAGE_URL=https://cctv.malangkota.go.id/sebaran-cctv
MALANG_STREAM_BASE=https://cctv.malangkota.go.id/cctv-stream/streams
MALANG_ORIGIN=https://cctv.malangkota.go.id
MALANG_DISTRICT_ID=99

# CCTV Kabupaten Mojokerto (API publik Cloudflare; media FLV melalui WSS)
MOJOKERTO_LIST_URL=https://dishubcctv.mojokertokab.go.id/api/master/perangkat/all-cctv
MOJOKERTO_ORIGIN=https://dishubcctv.mojokertokab.go.id
MOJOKERTO_STREAM_BASE=wss://dishubstreaming.mojokertokab.go.id/rtsp

# CCTV Tulungagung
TULUNGAGUNG_LIST_URL=https://cctvdishub.tulungagung.go.id/__data.json
TULUNGAGUNG_STREAM_BASE=https://cctvdishub.tulungagung.go.id/api

# CCTV Kota Surabaya (HTTP upstream; proxy same-origin wajib).
# Untuk production, utamakan tunnel/HTTPS resmi dan set URL di deployment env.
SURABAYA_BASE_URL=http://36.66.208.101:5000
SURABAYA_LIST_PATH=/cctvs
SURABAYA_STATUS_PATH=/api/cctv_statuses
SURABAYA_START_PATH=/api/start_stream
SURABAYA_STOP_PATH=/api/stop_stream
SURABAYA_HLS_PATH=/hls

# CCTV Kabupaten Bojonegoro (dataset resmi; session publik dibuat server-side)
BOJONEGORO_PAGE_URL=https://data.bojonegorokab.go.id/dinas-perhubungan.html@detail=cctv
BOJONEGORO_SESSION_PATH=/public/reff_dinhub/set_sessions_/sel_tahun/{year}
BOJONEGORO_MAP_PATH=/public/reff_dinhub/getCctv
BOJONEGORO_STREAM_BASE=https://data.bojonegorokab.go.id/live/public
BOJONEGORO_YEAR=2026
BOJONEGORO_USER_AGENT=Mozilla/5.0 (compatible; LENSAMAS CCTV proxy/1.0)

# CCTV Kabupaten Gresik (API publik + HLS; start/heartbeat/stop handled by proxy).
# Pastikan izin/ketentuan redistribusi dari pemilik portal sebelum production.
GRESIK_BASE_URL=https://cctvkanjeng.gresikkab.go.id
GRESIK_MARKERS_PATH=/api/v1/public/markers?mode=per_device&kind=cctv
GRESIK_LOCATIONS_PATH=/api/v1/public/locations
GRESIK_CCTV_PATH=/api/v1/public/cctv
GRESIK_HLS_PATH=/hls
GRESIK_USER_AGENT=Mozilla/5.0 (compatible; LENSAMAS CCTV proxy/1.0)

# CCTV Kabupaten Tuban
TUBAN_BASE_URL=https://cctv.tubankab.go.id
TUBAN_GEOMETRIES_PATH=/api/geometries
TUBAN_STREAM_TOKEN_PATH=/api/stream-token
TUBAN_TOKEN_TTL_SECONDS=120
TUBAN_USER_AGENT=Mozilla/5.0 (compatible; LENSAMAS CCTV proxy/1.0)

# CCTV Kabupaten Banyuwangi / Bondowoso / Situbondo / Pasuruan
BANYUWANGI_BASE_URL=https://ayobanyuwangi.id
BANYUWANGI_PAGE_PATH=/wp-json/wp/v2/pages/2844?_fields=id,modified,link,content.rendered
BANYUWANGI_STREAM_BASE=https://live.banyuwangikab.go.id/hls
BONDOWOSO_BASE_URL=https://dishub.bondowosokab.go.id
BONDOWOSO_PAGE_PATH=/cctv
BONDOWOSO_STREAM_BASE=https://cctv.bondowosokab.go.id/cgi-bin/nph-zms
# Isi hanya di server/Vercel; jangan commit atau kirim ke browser.
BONDOWOSO_STREAM_USER=
BONDOWOSO_STREAM_PASS=
BONDOWOSO_STREAM_SCALE=50
# nph-zms proxy selalu memakai mode mjpeg; jpeg hanya menghasilkan satu frame.
BONDOWOSO_STREAM_MAX_FPS=10
SITUBONDO_BASE_URL=https://cctv.situbondokab.go.id
SITUBONDO_LIST_PATH=/api/cctv
SITUBONDO_MJPEG_BASE=https://cctvlive.situbondokab.go.id/zm/cgi-bin/nph-zms
SITUBONDO_HLS_BASE=https://cctvstream.situbondokab.go.id
# Isi hanya di server/Vercel; jangan commit atau kirim ke browser.
SITUBONDO_ZM_USERNAME=
SITUBONDO_ZM_PASSWORD=
SITUBONDO_ZM_SCALE=50
SITUBONDO_ZM_MAX_FPS=5
# Proxy MJPEG dipaksa berhenti setelah 30 detik lalu browser reconnect otomatis.
# Naikkan hanya jika runtime Vercel/persistent proxy memiliki durasi yang cukup.
MJPEG_MAX_DURATION_MS=30000
PASURUAN_BASE_URL=https://dishub.pasuruankab.go.id
PASURUAN_GEOJSON_PATH=/maps/ajax/geojson
PASURUAN_GEOJSON_MARKER=2_2
PASURUAN_STREAM_BASE=https://dishub.pasuruankab.go.id:5444/LiveApp/streams
REGIONAL_CCTV_USER_AGENT=Mozilla/5.0 (compatible; LENSAMAS CCTV proxy/1.0)

# CCTV Kota Kediri
KEDIRI_STREAM_BASE=https://pplterpadu.kedirikota.go.id:8888

# Opsional: Jika ingin mengarahkan /api ke proxy kustom saat dev lokal
# DEV_API_PROXY=http://localhost:8787
